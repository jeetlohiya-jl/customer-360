From bf81562accfd478aed786bb99e2911502f85f141 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 12:35:52 +0000
Subject: [PATCH] Slack: evidence link opens on the days of the cited facts

The link went to all facts for the customer (516 for Premio), so the facts
behind an answer were hard to find. It now adds from/to for the cited days.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X2WTz1u98qqLv2LMT8WSf6
---
 lib/slack/answer.ts      | 19 ++++++++++++++++---
 tests/unit/slack.test.ts | 12 ++++++++++--
 2 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/lib/slack/answer.ts b/lib/slack/answer.ts
index f32b34c..6fe5370 100644
--- a/lib/slack/answer.ts
+++ b/lib/slack/answer.ts
@@ -240,8 +240,21 @@ export function buildAnswerPrompt(question: string, customers: CustomerMatch[],
 const escapeSlack = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
 
 /** Link to the Facts page for one customer (evidence quotes, source emails, review). */
-export function factsPageUrl(appUrl: string, customerId: string): string {
-  return `${appUrl.replace(/\/+$/, "")}/facts?customer=${encodeURIComponent(customerId)}`;
+export function factsPageUrl(appUrl: string, customerId: string, range?: { from: string; to: string }): string {
+  const days = range ? `&from=${range.from}&to=${range.to}` : "";
+  return `${appUrl.replace(/\/+$/, "")}/facts?customer=${encodeURIComponent(customerId)}${days}`;
+}
+
+/** The days (UTC, YYYY-MM-DD) of the cited facts of one customer, so the link opens on exactly those facts. */
+function citedRange(facts: SlackFact[], cited: Set<number>, customerId: string): { from: string; to: string } | undefined {
+  const days = [...cited]
+    .map((n) => facts[n - 1])
+    .filter((f) => f && f.customer_id === customerId)
+    .map((f) => new Date(f.message_at))
+    .filter((d) => !Number.isNaN(d.getTime()))
+    .map((d) => d.toISOString().slice(0, 10))
+    .sort();
+  return days.length ? { from: days[0], to: days[days.length - 1] } : undefined;
 }
 
 /**
@@ -262,7 +275,7 @@ export function renderAnswer(
       .trim(),
   );
   const title = `*${escapeSlack(opts.customers.map((c) => c.customer_name).join(", "))}*`;
-  const links = opts.customers.map((c) => `<${factsPageUrl(opts.appUrl, c.customer_id)}|${opts.customers.length > 1 ? escapeSlack(c.customer_name) : "evidence and sources"}>`);
+  const links = opts.customers.map((c) => `<${factsPageUrl(opts.appUrl, c.customer_id, citedRange(facts, cited, c.customer_id))}|${opts.customers.length > 1 ? escapeSlack(c.customer_name) : "evidence and sources"}>`);
   const footer = `_From ${cited.size || facts.length} stored fact${(cited.size || facts.length) === 1 ? "" : "s"} · ${links.join(" · ")}_`;
   let text = `${title}\n${body}\n${footer}`;
   if (text.length > MAX_REPLY_CHARS) text = `${text.slice(0, MAX_REPLY_CHARS - 1)}…`;
diff --git a/tests/unit/slack.test.ts b/tests/unit/slack.test.ts
index 5277e6e..1d3a785 100644
--- a/tests/unit/slack.test.ts
+++ b/tests/unit/slack.test.ts
@@ -162,13 +162,21 @@ describe("question handling (pure)", () => {
   });
 
   it("the reply is short: customer, answer without fact ids, one evidence link", () => {
-    const facts = [fact(), fact({ fact_id: "f2", summary: "PO came in", evidence_quote: "PO attached" })];
+    const facts = [fact(), fact({ fact_id: "f2", summary: "PO came in", evidence_quote: "PO attached", message_at: "2026-09-13T23:30:00.000Z" })];
     const out = renderAnswer("Quoted $0.21/tray FOB.\n• 12 Sep: quoted $0.21 [F1]\n• 13 Sep: PO came in (unverified) [F2, UNVERIFIED][F9] <!channel>", facts,
       { customers: ACME, appUrl: "https://c360.example/" });
     expect(out.cited).toBe(2);
     expect(out.text).toBe(
       "*Acme Foods*\nQuoted $0.21/tray FOB.\n• 12 Sep: quoted $0.21\n• 13 Sep: PO came in (unverified) &lt;!channel&gt;\n" +
-      "_From 2 stored facts · <https://c360.example/facts?customer=c1|evidence and sources>_");
+      "_From 2 stored facts · <https://c360.example/facts?customer=c1&from=2026-09-12&to=2026-09-13|evidence and sources>_");
+  });
+
+  it("the evidence link opens on the cited days only; no citations means all facts", () => {
+    const facts = [fact({ message_at: "2026-10-24T18:06:00Z" }), fact({ fact_id: "f2", summary: "Older", evidence_quote: "older", message_at: "2026-10-20T09:00:00Z" })];
+    expect(renderAnswer("24 Oct: kept the old quote. [F1]", facts, { customers: ACME, appUrl: "https://c360.example" }).text)
+      .toContain("facts?customer=c1&from=2026-10-24&to=2026-10-24|");
+    expect(renderAnswer("Nothing cited.", facts, { customers: ACME, appUrl: "https://c360.example" }).text)
+      .toContain("facts?customer=c1|");
   });
 
   it("no facts on the asked topic: a direct reply with the latest activity, no AI call needed", () => {
