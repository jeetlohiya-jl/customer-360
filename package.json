{
  "name": "customer-360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "db:start": "npx --yes supabase@2.120.0 start",
    "db:stop": "npx --yes supabase@2.120.0 stop",
    "db:reset": "npx --yes supabase@2.120.0 db reset",
    "db:test": "npx --yes supabase@2.120.0 test db",
    "db:test:local": "bash scripts/db-test-local.sh",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:bundle && npm run check:headers",
    "eval:extract": "vitest run --config vitest.eval.config.mts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
