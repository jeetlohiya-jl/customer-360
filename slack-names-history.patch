diff --git a/supabase/migrations/20261028000016_slack_history.sql b/supabase/migrations/20261028000016_slack_history.sql
new file mode 100644
index 0000000..aecceb8
--- /dev/null
+++ b/supabase/migrations/20261028000016_slack_history.sql
@@ -0,0 +1,49 @@
+-- Migration 0016: Slack history answers ("month-wise summary since the beginning").
+--
+-- A history answer needs facts from every month, not only the newest 120. The
+-- Slack worker may now read up to 1000 facts per question (the app samples a few
+-- per month before anything is sent to the AI). Who may see which fact is
+-- unchanged (same rule as 0015 / private.user_can_see_fact). No data is changed.
+--
+-- Reverse: supabase/rollback/20261028000016_slack_history.down.sql
+
+create or replace function private.worker_slack_facts(p_user uuid, p_customers uuid[], p_show_owner boolean, p_limit integer)
+returns table (
+  fact_id uuid, customer_id uuid, customer_name text, fact_type text, stance text, party text, basis text,
+  status text, status_basis text, stale boolean, product text, quantity numeric, unit text, unit_price numeric,
+  currency text, price_basis text, due_date date, due_text text, reference text, summary text, evidence_quote text,
+  confidence numeric, review_state text, message_at timestamptz, direction text, is_mine boolean,
+  source_owner_email text, mailbox_email text, gmail_message_id text
+)
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select f.id, f.customer_id, c.canonical_name, f.fact_type, f.stance, f.party, f.basis,
+         f.status, f.status_basis,
+         (f.status = 'open' and f.message_at < now() - interval '30 days'
+          and not exists (select 1 from private.customer_facts g where g.resolves_fact_id = f.id)),
+         f.product, f.quantity, f.unit, f.unit_price, f.currency, f.price_basis,
+         f.due_date, f.due_text, f.reference, f.summary, f.evidence_quote, f.confidence,
+         f.review_state, f.message_at, f.direction, f.owner_id = p_user,
+         case when f.owner_id = p_user or coalesce(p_show_owner, false) then u.email end,
+         case when f.owner_id = p_user then u.email end,
+         case when f.owner_id = p_user then f.gmail_message_id end
+    from private.customer_facts f
+    join public.customers c on c.id = f.customer_id
+    join public.app_users u on u.id = f.owner_id
+    -- 0015: the asker's rights are read once (me), not per fact; same rule as private.user_can_see_fact.
+    cross join (
+      select a.id, a.role = 'admin' as admin,
+             coalesce((select value from private.settings where key = 'facts_visibility'), 'reviewers') = 'all' as see_all
+        from public.app_users a
+       where a.id = p_user and a.status = 'active'
+    ) me
+   where f.customer_id = any (coalesce(p_customers, '{}'))
+     and cardinality(p_customers) between 1 and 5
+     and ((f.review_state in ('auto', 'confirmed', 'corrected') and (f.owner_id = me.id or me.admin or me.see_all))
+          or (f.review_state = 'needs_review' and (f.owner_id = me.id or me.admin)))
+   order by f.message_at desc, f.id desc
+   limit least(greatest(coalesce(p_limit, 60), 1), 1000)
+$$;
diff --git a/supabase/ops/2026-10-28_reextract_names.sql b/supabase/ops/2026-10-28_reextract_names.sql
new file mode 100644
index 0000000..7bd8de9
--- /dev/null
+++ b/supabase/ops/2026-10-28_reextract_names.sql
@@ -0,0 +1,42 @@
+-- Re-extract stored emails with prompt x6, which tells the AI who wrote and who
+-- received each email. Fixes facts that credit the wrong person ("Glenn" for
+-- Vaibhav's email, the mailbox owner instead of the writer).
+--
+-- Run ONLY after the x6 code is live. The guard below refuses to run until at
+-- least one email has been extracted with x6.
+--
+-- What it does: puts already-extracted emails back in the extraction queue.
+-- The worker re-reads each one (newest first, 25 a minute) and replaces that
+-- email's AI facts with new ones. Emails with any fact a person has confirmed,
+-- corrected or rejected are left alone, so no review work is lost. Links,
+-- customers and emails are not touched. Cost: about $0.0004 per email.
+begin;
+
+do $$
+begin
+  if not exists (select 1 from private.extraction_state where prompt_version = 'x6') then
+    raise exception 'x6 is not live yet: wait until the new code has extracted at least one email, then run this again';
+  end if;
+end $$;
+
+with requeue as (
+  select s.owner_id, s.gmail_message_id
+    from private.extraction_state s
+   where s.status = 'extracted'
+     and s.prompt_version in ('x3', 'x4', 'x5')
+     and not exists (select 1 from private.customer_facts f
+                      where f.owner_id = s.owner_id and f.gmail_message_id = s.gmail_message_id
+                        and f.review_state in ('confirmed', 'corrected', 'rejected'))
+)
+update private.extraction_state s
+   set status = 'pending', attempts = 0, next_attempt_at = null, lease_until = null, last_error = null, updated_at = now()
+  from requeue r
+ where s.owner_id = r.owner_id and s.gmail_message_id = r.gmail_message_id;
+
+insert into public.audit_log (actor, action, target, detail)
+select null, 'extraction.requeued', 'prompt x6',
+       jsonb_build_object('reason', 'names from From/To/Cc headers',
+                          'pending', (select count(*) from private.extraction_state where status = 'pending'));
+
+select count(*) as queued_for_reextraction from private.extraction_state where status = 'pending';
+commit;
