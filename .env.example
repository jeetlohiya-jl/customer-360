# Customer 360 environment variables.
# Copy to .env.local for local development:  cp .env.example .env.local
# Values here are placeholders or local defaults only. NEVER commit real secrets.
# In Vercel, enter each value in Project Settings -> Environment Variables.

# --- Supabase (public: shipped to browsers, protected by Row Level Security) ---
# Local stack default URL is http://127.0.0.1:54321 (from `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable / anon key. Local: printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>

# --- App ---
# Base URL used for OAuth redirects. Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Only this Google Workspace domain may sign in.
WORKSPACE_DOMAIN=gocirkla.com

# --- Feature flags ---
# Gmail connection proof of concept: "on" or "off". When "on", the three Gmail
# values below are required. Slack is not built and must stay "off".
FEATURE_GMAIL=off
FEATURE_SLACK=off

# --- Gmail connection (server-only; required when FEATURE_GMAIL=on) ---
# OAuth client "Customer 360 - Gmail" from Google Cloud (Web application).
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# 32 random bytes, base64. Generate (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Use a DIFFERENT key for local and production. Changing it disconnects stored mailboxes.
TOKEN_ENCRYPTION_KEY=
# Leave empty (defaults to 1). Increase only when rotating the key.
TOKEN_ENCRYPTION_KEY_VERSION=

# --- Server-only (not used by Phase 1 code; validated if present) ---
# Never prefix these with NEXT_PUBLIC_. Leave empty locally.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
