# Customer 360 environment variables.
# Copy to .env.local for local development:  cp .env.example .env.local
# Values here are placeholders or local defaults only. NEVER commit real secrets.
# In Vercel, enter each value in Project Settings -> Environment Variables.

# --- Supabase (public: shipped to browsers, protected by Row Level Security) ---
# Local stack default URL is http://127.0.0.1:54321 (from `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable / anon key. Local: printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>

# --- App ---
# Base URL used for OAuth redirects. Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Only this Google Workspace domain may sign in.
WORKSPACE_DOMAIN=gocirkla.com

# --- Phase 1 feature flags (must be "off"; the app refuses to start otherwise) ---
FEATURE_GMAIL=off
FEATURE_SLACK=off

# --- Server-only (not used by Phase 1 code; validated if present) ---
# Never prefix these with NEXT_PUBLIC_. Leave empty locally.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
