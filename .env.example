# Customer 360 environment variables.
# Copy to .env.local for local development:  cp .env.example .env.local
# Values here are placeholders or local defaults only. NEVER commit real secrets.
# In Vercel, enter each value in Project Settings -> Environment Variables.

# --- Supabase (public: shipped to browsers, protected by Row Level Security) ---
# Local stack default URL is http://127.0.0.1:54321 (from `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable / anon key. Local: printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>

# --- App ---
# Base URL used for OAuth redirects. Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Only this Google Workspace domain may sign in.
WORKSPACE_DOMAIN=gocirkla.com

# --- Feature flags ---
# Gmail connection proof of concept: "on" or "off". When "on", the three Gmail
# values below are required.
FEATURE_GMAIL=off
# Slack DM assistant: "on" works only with the Slack values at the end of this
# file, an Anthropic key and the worker database settings; otherwise it stays off.
FEATURE_SLACK=off

# --- Gmail connection (server-only; required when FEATURE_GMAIL=on) ---
# OAuth client "Customer 360 - Gmail" from Google Cloud (Web application).
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# 32 random bytes, base64. Generate (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Use a DIFFERENT key for local and production. Changing it disconnects stored mailboxes.
TOKEN_ENCRYPTION_KEY=
# Leave empty (defaults to 1). Increase only when rotating the key.
TOKEN_ENCRYPTION_KEY_VERSION=

# --- Server-only (not used by Phase 1 code; validated if present) ---
# Never prefix these with NEXT_PUBLIC_. Leave empty locally.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Stage 3.1 header scan (off unless explicitly "on") ---
# Needs FEATURE_GMAIL=on. Even when on, nothing scans until a mailbox is on the
# database allowlist (private.settings 'scan_allowed_mailboxes') and its owner
# clicks "Scan my mailbox".
# Stage 3.1.1: a wrong value in this section never stops the site. Scanning is
# switched off instead, and the logs show {"event":"scan_config_invalid"} with
# the variable NAME and the problem (never the value).
FEATURE_SCAN=off
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to the cron route. 32+ random characters.
CRON_SECRET=
# The c360_worker login (Supabase pooler URL). The password is set by an operator in the SQL editor.
WORKER_DATABASE_URL=
# Optional: Supabase's database CA certificate (PEM) to verify the TLS connection.
# Paste the whole certificate including the BEGIN/END lines. Literal "\n" is accepted.
WORKER_DATABASE_CA=

# --- Stage B + C extraction (OFF; needs separate approval to enable) ---
# Off unless explicitly "on". Also needs a valid scan configuration above.
# Even when on, nothing is read until a mailbox is on the database's
# extraction allowlist AND its owner has reconnected with gmail.readonly
# (not requested by this build). A wrong value only turns extraction off.
FEATURE_EXTRACT=off
# "on" makes the Gmail connect button ask for gmail.readonly (email content)
# instead of gmail.metadata. Approval step: each person reconnects afterwards.
GMAIL_CONTENT_ACCESS=off
# Anthropic API key (sk-ant-...) from a dedicated Customer 360 workspace with a
# $50 monthly spend limit. Server-only; never commit it.
ANTHROPIC_API_KEY=

# --- Slack DM assistant (server-only; used only when FEATURE_SLACK=on) ---
# From the "Customer 360" Slack app: Basic Information > Signing Secret, and
# OAuth & Permissions > Bot User OAuth Token (xoxb-...). Never commit them.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
